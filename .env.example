# Configuración del servidor Next.js para el proyecto Dhyana.
SUPABASE_URL=https://vabbjwjfwcypweucfjhx.supabase.co
# Completar únicamente en .env.local desde Supabase > Settings > API Keys.
# Usar una Secret key (sb_secret_...), sin prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Clave publicable del mismo proyecto; Auth se ejecuta en servidor.
SUPABASE_PUBLISHABLE_KEY=
# Origen exacto autorizado para formularios y enlaces (HTTPS al publicar).
APP_URL=http://localhost:3000
