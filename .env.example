# Configuración del servidor Next.js para el proyecto Dhyana.
SUPABASE_URL=https://vabbjwjfwcypweucfjhx.supabase.co
# Completar únicamente en .env.local desde Supabase > Settings > API Keys.
# Usar una Secret key (sb_secret_...), sin prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Clave publicable del mismo proyecto; Auth se ejecuta en servidor.
SUPABASE_PUBLISHABLE_KEY=
# Origen exacto autorizado para formularios y enlaces (HTTPS al publicar).
APP_URL=http://localhost:3000
# Correo del Libro de Reclamaciones. Sin configurar, las hojas se registran
# igual; solo falla el envío de la constancia.
# TEMPORAL mientras no hay dominio propio: Gmail con contraseña de aplicación
# (myaccount.google.com/apppasswords, requiere verificación en dos pasos).
# Si están completas, tienen prioridad sobre Resend.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
# Con dominio verificado en Resend: completar estas y vaciar las de Gmail.
RESEND_API_KEY=
COMPLAINT_BOOK_EMAIL_FROM=
